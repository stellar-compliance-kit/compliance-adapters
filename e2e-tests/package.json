{
  "name": "e2e-tests",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end integration tests for compliance adapters",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p .",
