  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1",
    "horizon-listener": "*",
    "sanctions-oracle": "*"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "jest": "^30.5.0",
    "ts-jest": "^29.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0"
  }
}
